{
  "entities": {
    "AccessConfig": {
      "title": "AccessConfig",
      "description": "Admin-editable lobby, trial duration, and monthly subscription settings.",
      "type": "object",
      "properties": {
        "lobbyTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Main headline displayed on the public lobby screen."
        },
        "lobbySubtitle": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Subtitle describing the platform value in the lobby."
        },
        "trialEnabled": {
          "type": "boolean",
          "description": "Whether new users can request a free trial."
        },
        "trialDays": {
          "type": "number",
          "description": "Default number of days granted when admin approves a trial (1-365)."
        },
        "trialTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Title of the trial plan card."
        },
        "trialDescription": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Description of what is included in the trial mode."
        },
        "subscriptionTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Title of the monthly subscription card."
        },
        "subscriptionPrice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Displayed monthly price label (e.g. '$15 / mes')."
        },
        "subscriptionCycleDays": {
          "type": "number",
          "description": "Number of days granted per approved monthly subscription cycle (1-365)."
        },
        "subscriptionDescription": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Summary of the monthly subscription plan."
        },
        "subscriptionFeatures": {
          "type": "array",
          "description": "Bounded list (max 10) of monthly subscription benefits."
        },
        "paymentInstructions": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000,
          "description": "Instructions for completing monthly payment before admin approval."
        },
        "supportContact": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Contact email, WhatsApp, or URL for user assistance."
        },
        "binanceEnabled": {
          "type": "boolean",
          "description": "Whether Binance Pay is displayed as a payment option."
        },
        "binancePayId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Admin Binance Pay ID or UID."
        },
        "binanceEmail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 180,
          "description": "Admin Binance account email."
        },
        "binanceHolder": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Admin Binance account holder name or nickname."
        },
        "binanceWalletAddress": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
          "description": "Admin Binance crypto wallet deposit address (e.g. USDT TRC20/BEP20)."
        },
        "binancePaymentLink": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "pattern": "^(|https?://.+)$",
          "description": "Optional HTTPS payment link for Binance Pay."
        },
        "binanceNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Additional Binance payment instructions or accepted network."
        },
        "pagoMovilEnabled": {
          "type": "boolean",
          "description": "Whether Pago Móvil is displayed as a payment option."
        },
        "pagoMovilBank": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Bank name and code for Pago Móvil."
        },
        "pagoMovilPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Phone number registered for Pago Móvil."
        },
        "pagoMovilId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "National ID (Cédula/RIF) registered for Pago Móvil."
        },
        "pagoMovilHolder": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Account holder name for Pago Móvil."
        },
        "pagoMovilNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Additional Pago Móvil instructions such as exchange rate notes."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last admin update."
        }
      },
      "required": [
        "lobbyTitle",
        "lobbySubtitle",
        "trialEnabled",
        "trialDays",
        "trialTitle",
        "trialDescription",
        "subscriptionTitle",
        "subscriptionPrice",
        "subscriptionCycleDays",
        "subscriptionDescription",
        "subscriptionFeatures",
        "paymentInstructions",
        "supportContact",
        "updatedAt"
      ]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Access control, trial approval, and monthly subscription monitoring record per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the registered account."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "description": "Verified email address of the registered user (PII, restricted to owner and admin)."
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Display name provided by the user."
        },
        "businessName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Brand or agency name submitted for admin verification."
        },
        "accessStatus": {
          "type": "string",
          "enum": [
            "unassigned",
            "pending_trial",
            "pending_subscription",
            "trial_active",
            "subscription_active",
            "permanent_active",
            "rejected",
            "suspended"
          ],
          "description": "Current access and approval status controlled by the admin."
        },
        "requestedPlan": {
          "type": "string",
          "enum": ["none", "trial", "subscription"],
          "description": "Plan requested by the user."
        },
        "hasUsedTrial": {
          "type": "boolean",
          "description": "True once the admin has granted a trial, preventing repeated trial requests."
        },
        "trialDaysGranted": {
          "type": "number",
          "description": "Number of trial days last granted by the admin (0-365)."
        },
        "accessExpiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Nullable timestamp when current trial or monthly subscription expires."
        },
        "paymentReference": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
          "description": "Payment reference or confirmation note submitted by the user."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["none", "binance", "pago_movil", "other"],
          "description": "Payment method used by the client for their subscription."
        },
        "paymentProofUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 250000,
          "description": "Compressed JPEG data URL of the payment screenshot uploaded by the client."
        },
        "userNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400,
          "description": "Optional note sent by the user to the administrator."
        },
        "adminNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400,
          "description": "Internal admin notes for monitoring this account."
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Nullable timestamp when the user submitted their latest access request."
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Nullable timestamp when the admin last approved access."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account first registered."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last account update."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "businessName",
        "accessStatus",
        "requestedPlan",
        "hasUsedTrial",
        "trialDaysGranted",
        "accessExpiresAt",
        "paymentReference",
        "userNote",
        "adminNote",
        "requestedAt",
        "approvedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin role assignment document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "description": "Verified email address of the administrator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "AdminSecurity": {
      "title": "AdminSecurity",
      "description": "Admin-only salted SHA-256 PIN verification record (4 or 6 digits).",
      "type": "object",
      "properties": {
        "pinHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hex digest of salt + PIN."
        },
        "pinSalt": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[a-f0-9]+$",
          "description": "Random hex salt used to hash the admin PIN."
        },
        "pinLength": {
          "type": "number",
          "enum": [4, 6],
          "description": "Configured PIN digit length (4 or 6)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last PIN update."
        }
      },
      "required": ["pinHash", "pinSalt", "pinLength", "updatedAt"]
    },
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Root workspace document owned by an authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the workspace owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Display name shown in the workspace header."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the workspace was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the workspace was last updated."
        }
      },
      "required": ["ownerId", "displayName", "createdAt", "updatedAt"]
    },
    "BrandProfile": {
      "title": "BrandProfile",
      "description": "Social profile and branding configuration for a managed brand space.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique brand identifier."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who owns this brand."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Visible brand name."
        },
        "badge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "description": "Short monogram initials."
        },
        "accent": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^#[0-9a-fA-F]{3,8}$",
          "description": "Hex brand accent color."
        },
        "accentLight": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^#[0-9a-fA-F]{3,8}$",
          "description": "Light tint hex color."
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Multiline bio displayed in social previews."
        },
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Social handle without leading @."
        },
        "category": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60,
          "description": "Instagram profile category."
        },
        "website": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Profile website link text."
        },
        "avatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 250000,
          "description": "Optional compressed data URL or HTTPS image URL for avatar."
        },
        "verified": {
          "type": "boolean",
          "description": "Whether to display verified badge in preview."
        },
        "igPostsOverride": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20,
          "description": "Optional custom posts count text for Instagram."
        },
        "igFollowers": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20,
          "description": "Instagram followers count label."
        },
        "igFollowing": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20,
          "description": "Instagram following count label."
        },
        "showStoryRing": {
          "type": "boolean",
          "description": "Whether to show the active story gradient ring."
        },
        "ttFollowing": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20,
          "description": "TikTok following count label."
        },
        "ttFollowers": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20,
          "description": "TikTok followers count label."
        },
        "ttLikes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20,
          "description": "TikTok likes count label."
        },
        "ttShowPinned": {
          "type": "boolean",
          "description": "Whether to display Pinned tag on first TikTok video."
        },
        "highlights": {
          "type": "array",
          "description": "Bounded list (max 12) of Instagram story highlights."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "badge",
        "accent",
        "accentLight",
        "description",
        "handle",
        "category",
        "website",
        "igFollowers",
        "igFollowing",
        "ttFollowing",
        "ttFollowers",
        "ttLikes",
        "highlights",
        "createdAt",
        "updatedAt"
      ]
    },
    "ContentPost": {
      "title": "ContentPost",
      "description": "Editorial content item managed in Kanban, Calendar, and Visual Feed.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique post document ID."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who owns this post."
        },
        "brandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Brand space ID this post belongs to."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Content piece title."
        },
        "status": {
          "type": "string",
          "enum": [
            "estrategia",
            "produccion",
            "copywriting",
            "programado",
            "publicado"
          ],
          "description": "Current Kanban workflow column."
        },
        "platform": {
          "type": "string",
          "enum": ["Instagram", "TikTok", "Web/Lanzamientos"],
          "description": "Target social platform."
        },
        "contentType": {
          "type": "string",
          "enum": [
            "Reel",
            "Carrusel",
            "Historia",
            "Lanzamiento de Producto",
            "Tanda"
          ],
          "description": "Editorial format type."
        },
        "date": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16,
          "description": "Scheduled date YYYY-MM-DD."
        },
        "time": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "description": "Scheduled time HH:mm."
        },
        "assignee": {
          "type": "string",
          "enum": ["Andrés", "Valeria", "Isaac", "Diseño Éxodo"],
          "description": "Assigned team member."
        },
        "coverUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 250000,
          "description": "Cover artwork SVG/JPEG data URL or HTTPS URL."
        },
        "mediaType": {
          "type": "string",
          "enum": ["image", "video"],
          "description": "Primary media kind."
        },
        "mediaItems": {
          "type": "array",
          "description": "Bounded list (max 10) of reference media items."
        },
        "caption": {
          "type": "string",
          "minLength": 0,
          "maxLength": 3000,
          "description": "Post caption copy."
        },
        "hashtags": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000,
          "description": "Hashtag list text."
        },
        "cta": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Call to action copy."
        },
        "internalNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "Internal production notes."
        },
        "checklist": {
          "type": "array",
          "description": "Bounded list (max 30) of checklist subtasks."
        },
        "comments": {
          "type": "array",
          "description": "Bounded list (max 50) of team comments."
        },
        "feedOrder": {
          "type": "number",
          "description": "Ordering position within the brand feed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "brandId",
        "title",
        "status",
        "platform",
        "contentType",
        "date",
        "time",
        "assignee",
        "coverUrl",
        "mediaType",
        "mediaItems",
        "caption",
        "hashtags",
        "cta",
        "internalNotes",
        "checklist",
        "comments",
        "feedOrder",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/appConfig/{configId}": {
      "schema": {
        "$ref": "#/entities/AccessConfig"
      },
      "description": "Admin-managed lobby copy, trial duration, and monthly subscription pricing/instructions."
    },
    "/accounts/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "User access registration, trial approval, and monthly subscription monitoring records (PII restricted to owner and admin)."
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/AdminRecord"
      },
      "description": "Trusted administrator directory managed by the bootstrap admin."
    },
    "/adminSecurity/{settingId}": {
      "schema": {
        "$ref": "#/entities/AdminSecurity"
      },
      "description": "Admin-only salted SHA-256 PIN verification settings (4 or 6 digits)."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserWorkspace"
      },
      "description": "Root workspace document per approved user (no PII)."
    },
    "/users/{userId}/brands/{brandId}": {
      "schema": {
        "$ref": "#/entities/BrandProfile"
      },
      "description": "Customizable social brand profiles owned by the user."
    },
    "/users/{userId}/posts/{postId}": {
      "schema": {
        "$ref": "#/entities/ContentPost"
      },
      "description": "Editorial content pieces managed across Kanban, Calendar, and Feed."
    }
  }
}
