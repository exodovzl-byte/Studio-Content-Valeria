rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== GLOBAL PRIMITIVES ====================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'exodovzl@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function workspaceExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function brandExistsAfter(userId, brandId) {
      return existsAfter(/databases/$(database)/documents/users/$(userId)/brands/$(brandId));
    }

    function hasActiveAccess(userId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/accounts/$(userId))
        && get(/databases/$(database)/documents/accounts/$(userId)).data.accessStatus in ['trial_active', 'subscription_active']
        && get(/databases/$(database)/documents/accounts/$(userId)).data.accessExpiresAt is timestamp
        && get(/databases/$(database)/documents/accounts/$(userId)).data.accessExpiresAt > request.time
      );
    }

    // ==================== VALIDATION BLUEPRINTS ====================
    function isValidAccessConfig(data) {
      return data.keys().hasAll([
          'lobbyTitle', 'lobbySubtitle', 'trialEnabled', 'trialDays',
          'trialTitle', 'trialDescription', 'subscriptionTitle',
          'subscriptionPrice', 'subscriptionCycleDays', 'subscriptionDescription',
          'subscriptionFeatures', 'paymentInstructions', 'supportContact',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'lobbyTitle', 'lobbySubtitle', 'trialEnabled', 'trialDays',
          'trialTitle', 'trialDescription', 'subscriptionTitle',
          'subscriptionPrice', 'subscriptionCycleDays', 'subscriptionDescription',
          'subscriptionFeatures', 'paymentInstructions', 'supportContact',
          'updatedAt'
        ])
        && data.lobbyTitle is string && data.lobbyTitle.size() >= 1 && data.lobbyTitle.size() <= 100
        && data.lobbySubtitle is string && data.lobbySubtitle.size() <= 300
        && data.trialEnabled is bool
        && data.trialDays is number && data.trialDays >= 1 && data.trialDays <= 365
        && data.trialTitle is string && data.trialTitle.size() >= 1 && data.trialTitle.size() <= 80
        && data.trialDescription is string && data.trialDescription.size() <= 300
        && data.subscriptionTitle is string && data.subscriptionTitle.size() >= 1 && data.subscriptionTitle.size() <= 80
        && data.subscriptionPrice is string && data.subscriptionPrice.size() >= 1 && data.subscriptionPrice.size() <= 40
        && data.subscriptionCycleDays is number && data.subscriptionCycleDays >= 1 && data.subscriptionCycleDays <= 365
        && data.subscriptionDescription is string && data.subscriptionDescription.size() <= 300
        && data.subscriptionFeatures is list
        && data.subscriptionFeatures.size() <= 10
        && (data.subscriptionFeatures.size() == 0 || (data.subscriptionFeatures[0] is string && data.subscriptionFeatures[0].size() <= 120))
        && data.paymentInstructions is string && data.paymentInstructions.size() <= 1000
        && data.supportContact is string && data.supportContact.size() <= 160
        && data.updatedAt is timestamp;
    }

    function isValidAdminSecurity(data) {
      return data.keys().hasAll(['pinHash', 'pinSalt', 'pinLength', 'updatedAt'])
        && data.keys().hasOnly(['pinHash', 'pinSalt', 'pinLength', 'updatedAt'])
        && data.pinHash is string && data.pinHash.size() == 64 && data.pinHash.matches('^[a-f0-9]{64}$')
        && data.pinSalt is string && data.pinSalt.size() >= 16 && data.pinSalt.size() <= 64 && data.pinSalt.matches('^[a-f0-9]+$')
        && data.pinLength is number && data.pinLength in [4, 6]
        && data.updatedAt is timestamp;
    }

    function isValidAccount(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'businessName', 'accessStatus',
          'requestedPlan', 'hasUsedTrial', 'trialDaysGranted', 'accessExpiresAt',
          'paymentReference', 'userNote', 'adminNote', 'requestedAt',
          'approvedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'businessName', 'accessStatus',
          'requestedPlan', 'hasUsedTrial', 'trialDaysGranted', 'accessExpiresAt',
          'paymentReference', 'userNote', 'adminNote', 'requestedAt',
          'approvedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && data.displayName is string && data.displayName.size() <= 120
        && data.businessName is string && data.businessName.size() <= 120
        && data.accessStatus in [
          'unassigned', 'pending_trial', 'pending_subscription',
          'trial_active', 'subscription_active', 'rejected', 'suspended'
        ]
        && data.requestedPlan in ['none', 'trial', 'subscription']
        && data.hasUsedTrial is bool
        && data.trialDaysGranted is number && data.trialDaysGranted >= 0 && data.trialDaysGranted <= 365
        && (data.accessExpiresAt == null || data.accessExpiresAt is timestamp)
        && data.paymentReference is string && data.paymentReference.size() <= 200
        && data.userNote is string && data.userNote.size() <= 400
        && data.adminNote is string && data.adminNote.size() <= 400
        && (data.requestedAt == null || data.requestedAt is timestamp)
        && (data.approvedAt == null || data.approvedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == adminId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && data.createdAt is timestamp;
    }

    function isValidWorkspace(data, userId) {
      return data.keys().hasAll(['ownerId', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBrand(data, userId, brandId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'badge', 'accent', 'accentLight',
          'description', 'handle', 'category', 'website',
          'igFollowers', 'igFollowing', 'ttFollowing', 'ttFollowers', 'ttLikes',
          'highlights', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'name', 'badge', 'accent', 'accentLight',
          'description', 'handle', 'category', 'website',
          'avatarUrl', 'verified', 'igPostsOverride',
          'igFollowers', 'igFollowing', 'showStoryRing',
          'ttFollowing', 'ttFollowers', 'ttLikes', 'ttShowPinned',
          'highlights', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id.size() <= 64
        && data.id == brandId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.badge is string && data.badge.size() >= 1 && data.badge.size() <= 4
        && data.accent is string && data.accent.size() >= 4 && data.accent.size() <= 16 && data.accent.matches('^#[0-9a-fA-F]{3,8}$')
        && data.accentLight is string && data.accentLight.size() >= 4 && data.accentLight.size() <= 16 && data.accentLight.matches('^#[0-9a-fA-F]{3,8}$')
        && data.description is string && data.description.size() <= 300
        && data.handle is string && data.handle.size() >= 1 && data.handle.size() <= 60
        && data.category is string && data.category.size() <= 60
        && data.website is string && data.website.size() <= 160
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 250000))
        && (!('verified' in data) || data.verified is bool)
        && (!('igPostsOverride' in data) || (data.igPostsOverride is string && data.igPostsOverride.size() <= 20))
        && data.igFollowers is string && data.igFollowers.size() <= 20
        && data.igFollowing is string && data.igFollowing.size() <= 20
        && (!('showStoryRing' in data) || data.showStoryRing is bool)
        && data.ttFollowing is string && data.ttFollowing.size() <= 20
        && data.ttFollowers is string && data.ttFollowers.size() <= 20
        && data.ttLikes is string && data.ttLikes.size() <= 20
        && (!('ttShowPinned' in data) || data.ttShowPinned is bool)
        && data.highlights is list
        && data.highlights.size() <= 12
        && (data.highlights.size() == 0 || data.highlights[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPost(data, userId, postId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'brandId', 'title', 'status', 'platform', 'contentType',
          'date', 'time', 'assignee', 'coverUrl', 'mediaType', 'mediaItems',
          'caption', 'hashtags', 'cta', 'internalNotes', 'checklist', 'comments',
          'feedOrder', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'brandId', 'title', 'status', 'platform', 'contentType',
          'date', 'time', 'assignee', 'coverUrl', 'mediaType', 'mediaItems',
          'caption', 'hashtags', 'cta', 'internalNotes', 'checklist', 'comments',
          'feedOrder', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == postId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.brandId)
        && data.brandId.size() <= 64
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.status in ['estrategia', 'produccion', 'copywriting', 'programado', 'publicado']
        && data.platform in ['Instagram', 'TikTok', 'Web/Lanzamientos']
        && data.contentType in ['Reel', 'Carrusel', 'Historia', 'Lanzamiento de Producto', 'Tanda']
        && data.date is string && data.date.size() <= 16
        && data.time is string && data.time.size() <= 10
        && data.assignee in ['Andrés', 'Valeria', 'Isaac', 'Diseño Éxodo']
        && data.coverUrl is string && data.coverUrl.size() <= 250000
        && data.mediaType in ['image', 'video']
        && data.mediaItems is list
        && data.mediaItems.size() <= 10
        && (data.mediaItems.size() == 0 || data.mediaItems[0] is map)
        && data.caption is string && data.caption.size() <= 3000
        && data.hashtags is string && data.hashtags.size() <= 1000
        && data.cta is string && data.cta.size() <= 500
        && data.internalNotes is string && data.internalNotes.size() <= 2000
        && data.checklist is list
        && data.checklist.size() <= 30
        && (data.checklist.size() == 0 || data.checklist[0] is map)
        && data.comments is list
        && data.comments.size() <= 50
        && (data.comments.size() == 0 || data.comments[0] is map)
        && data.feedOrder is number && data.feedOrder >= 0 && data.feedOrder <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ==================== APP CONFIG (LOBBY & SUBSCRIPTION SETTINGS) ====================
    match /appConfig/{configId} {
      allow get: if isValidId(configId) && configId == 'access';
      allow list: if false;

      allow create: if isValidId(configId)
        && configId == 'access'
        && isValidAccessConfig(incoming())
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isValidId(configId)
        && configId == 'access'
        && isValidAccessConfig(incoming())
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'lobbyTitle', 'lobbySubtitle', 'trialEnabled', 'trialDays',
          'trialTitle', 'trialDescription', 'subscriptionTitle',
          'subscriptionPrice', 'subscriptionCycleDays', 'subscriptionDescription',
          'subscriptionFeatures', 'paymentInstructions', 'supportContact',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // ==================== ADMIN SECURITY (4/6-DIGIT PIN HASH) ====================
    match /adminSecurity/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'pin' && isAdmin();
      allow list: if false;

      allow create: if isValidId(settingId)
        && settingId == 'pin'
        && isValidAdminSecurity(incoming())
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isValidId(settingId)
        && settingId == 'pin'
        && isValidAdminSecurity(incoming())
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'pinHash', 'pinSalt', 'pinLength', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // ==================== ADMINS REGISTRY ====================
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isBootstrapAdmin());
      allow list: if isBootstrapAdmin();

      allow create: if isValidId(adminId)
        && isValidAdminRecord(incoming(), adminId)
        && incoming().createdAt == request.time
        && isBootstrapAdmin();

      allow update: if false;
      allow delete: if isValidId(adminId) && isBootstrapAdmin();
    }

    // ==================== USER ACCOUNTS (ACCESS & SUBSCRIPTIONS) ====================
    match /accounts/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrapAdmin();

      allow create: if isValidId(userId)
        && isValidAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && incoming().email == request.auth.token.email
            && incoming().accessStatus in ['unassigned', 'pending_trial', 'pending_subscription']
            && incoming().hasUsedTrial == false
            && incoming().trialDaysGranted == 0
            && incoming().accessExpiresAt == null
            && incoming().adminNote == ''
            && incoming().approvedAt == null
            && (
              (incoming().accessStatus == 'unassigned' && incoming().requestedPlan == 'none' && incoming().requestedAt == null) ||
              (incoming().accessStatus == 'pending_trial' && incoming().requestedPlan == 'trial' && incoming().requestedAt == request.time) ||
              (incoming().accessStatus == 'pending_subscription' && incoming().requestedPlan == 'subscription' && incoming().requestedAt == request.time)
            )
          )
        );

      allow update: if isValidId(userId)
        && isValidAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Admin monitoring, approvals, custom dates, legacy email update, suspensions & notes
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'email', 'displayName', 'businessName', 'accessStatus', 'requestedPlan',
              'hasUsedTrial', 'trialDaysGranted', 'accessExpiresAt',
              'paymentReference', 'userNote', 'adminNote', 'requestedAt',
              'approvedAt', 'updatedAt'
            ])
          ) ||
          // Tier 2A: Owner submitting a trial request (only if never used trial and not suspended)
          (
            isOwner(userId)
            && incoming().email == existing().email
            && existing().hasUsedTrial == false
            && existing().accessStatus != 'suspended'
            && incoming().hasUsedTrial == existing().hasUsedTrial
            && incoming().trialDaysGranted == existing().trialDaysGranted
            && incoming().accessExpiresAt == existing().accessExpiresAt
            && incoming().adminNote == existing().adminNote
            && incoming().approvedAt == existing().approvedAt
            && incoming().accessStatus == 'pending_trial'
            && incoming().requestedPlan == 'trial'
            && incoming().requestedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'businessName', 'accessStatus', 'requestedPlan',
              'userNote', 'requestedAt', 'updatedAt'
            ])
          ) ||
          // Tier 2B: Owner submitting a monthly subscription or renewal payment request
          (
            isOwner(userId)
            && incoming().email == existing().email
            && incoming().hasUsedTrial == existing().hasUsedTrial
            && incoming().trialDaysGranted == existing().trialDaysGranted
            && incoming().accessExpiresAt == existing().accessExpiresAt
            && incoming().adminNote == existing().adminNote
            && incoming().approvedAt == existing().approvedAt
            && incoming().accessStatus == 'pending_subscription'
            && incoming().requestedPlan == 'subscription'
            && incoming().requestedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'businessName', 'accessStatus', 'requestedPlan',
              'paymentReference', 'userNote', 'requestedAt', 'updatedAt'
            ])
          ) ||
          // Tier 2C: Active user submitting early monthly renewal without losing current active access
          (
            isOwner(userId)
            && incoming().email == existing().email
            && existing().accessStatus in ['trial_active', 'subscription_active']
            && incoming().accessStatus == existing().accessStatus
            && incoming().hasUsedTrial == existing().hasUsedTrial
            && incoming().trialDaysGranted == existing().trialDaysGranted
            && incoming().accessExpiresAt == existing().accessExpiresAt
            && incoming().adminNote == existing().adminNote
            && incoming().approvedAt == existing().approvedAt
            && incoming().requestedPlan == 'subscription'
            && incoming().requestedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'businessName', 'requestedPlan',
              'paymentReference', 'userNote', 'requestedAt', 'updatedAt'
            ])
          ) ||
          // Tier 2D: Legacy pre-registered owner syncing their verified email on first login
          (
            isOwner(userId)
            && existing().email == 'pendiente@sincronizar.app'
            && incoming().email == request.auth.token.email
            && incoming().accessStatus == existing().accessStatus
            && incoming().requestedPlan == existing().requestedPlan
            && incoming().hasUsedTrial == existing().hasUsedTrial
            && incoming().trialDaysGranted == existing().trialDaysGranted
            && incoming().accessExpiresAt == existing().accessExpiresAt
            && incoming().adminNote == existing().adminNote
            && incoming().approvedAt == existing().approvedAt
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'email', 'displayName', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // ==================== USER WORKSPACE ====================
    match /users/{userId} {
      allow get: if isValidId(userId) && (
        isBootstrapAdmin() || (
          isOwner(userId)
          && (resource == null || existing().ownerId == request.auth.uid)
          && hasActiveAccess(userId)
        )
      );
      allow list: if isBootstrapAdmin();

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && hasActiveAccess(userId);

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && hasActiveAccess(userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);

      allow delete: if isValidId(userId)
        && isOwner(userId)
        && (resource == null || existing().ownerId == request.auth.uid)
        && hasActiveAccess(userId);

      // ==================== BRANDS SUBCOLLECTION ====================
      match /brands/{brandId} {
        allow get: if isValidId(userId)
          && isValidId(brandId)
          && isOwner(userId)
          && (resource == null || existing().ownerId == request.auth.uid)
          && hasActiveAccess(userId)
          && workspaceExists(userId);

        allow list: if isValidId(userId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(brandId)
          && isOwner(userId)
          && isValidBrand(incoming(), userId, brandId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasActiveAccess(userId)
          && workspaceExists(userId);

        allow update: if isValidId(userId)
          && isValidId(brandId)
          && isOwner(userId)
          && isValidBrand(incoming(), userId, brandId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasActiveAccess(userId)
          && workspaceExists(userId)
          && (
            // Action: Update identity & profile bio
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'badge', 'accent', 'accentLight', 'description',
              'handle', 'category', 'website', 'avatarUrl', 'verified', 'updatedAt'
            ]) ||
            // Action: Update Instagram settings & highlights
            incoming().diff(existing()).affectedKeys().hasOnly([
              'igPostsOverride', 'igFollowers', 'igFollowing',
              'showStoryRing', 'highlights', 'updatedAt'
            ]) ||
            // Action: Update TikTok settings
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ttFollowing', 'ttFollowers', 'ttLikes', 'ttShowPinned', 'updatedAt'
            ]) ||
            // Action: Full brand profile save or reset
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'badge', 'accent', 'accentLight', 'description',
              'handle', 'category', 'website', 'avatarUrl', 'verified',
              'igPostsOverride', 'igFollowers', 'igFollowing', 'showStoryRing',
              'ttFollowing', 'ttFollowers', 'ttLikes', 'ttShowPinned',
              'highlights', 'updatedAt'
            ])
          );

        allow delete: if isValidId(userId)
          && isValidId(brandId)
          && isOwner(userId)
          && (resource == null || existing().ownerId == request.auth.uid)
          && hasActiveAccess(userId)
          && workspaceExists(userId);
      }

      // ==================== POSTS SUBCOLLECTION ====================
      match /posts/{postId} {
        allow get: if isValidId(userId)
          && isValidId(postId)
          && isOwner(userId)
          && (resource == null || existing().ownerId == request.auth.uid)
          && hasActiveAccess(userId)
          && workspaceExists(userId);

        allow list: if isValidId(userId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(postId)
          && isOwner(userId)
          && isValidPost(incoming(), userId, postId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasActiveAccess(userId)
          && workspaceExists(userId)
          && brandExistsAfter(userId, incoming().brandId);

        allow update: if isValidId(userId)
          && isValidId(postId)
          && isOwner(userId)
          && isValidPost(incoming(), userId, postId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasActiveAccess(userId)
          && workspaceExists(userId)
          && (
            // Action: Move Kanban stage
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
            // Action: Reorder Visual Feed
            incoming().diff(existing()).affectedKeys().hasOnly(['feedOrder', 'updatedAt']) ||
            // Action: Edit content details, metadata, checklist, comments, or media
            incoming().diff(existing()).affectedKeys().hasOnly([
              'brandId', 'title', 'status', 'platform', 'contentType',
              'date', 'time', 'assignee', 'coverUrl', 'mediaType', 'mediaItems',
              'caption', 'hashtags', 'cta', 'internalNotes', 'checklist',
              'comments', 'feedOrder', 'updatedAt'
            ])
          );

        allow delete: if isValidId(userId)
          && isValidId(postId)
          && isOwner(userId)
          && (resource == null || existing().ownerId == request.auth.uid)
          && hasActiveAccess(userId)
          && workspaceExists(userId);
      }
    }
  }
}
